# ===========================================================================
# AajoTestOS environment
#
# Every value below is optional. The defaults run a complete, working system
# on http://localhost:8080 with no configuration at all.
# ===========================================================================

# Port for the whole application: pages, API and the realtime gateway all share
# it. Hosting platforms (Railway, Render, Fly) inject this themselves.
PORT=8080

# Interface to bind. 0.0.0.0 is required for tunnels, other devices on your
# network, and containers. Use 127.0.0.1 to restrict access to this machine.
HOST=0.0.0.0

# Where the JSON store and uploaded media live. Point this at a mounted volume
# in production, otherwise a redeploy wipes every account.
# DATA_DIR=/data

# Extra hostnames allowed to reach the DEV server cross origin, comma separated.
# Common tunnel domains are already trusted; add anything unusual here.
# Has no effect on a production build.
# DEV_ORIGINS=mytunnel.example.com

# Only needed if the realtime gateway runs on a different host from the app.
# Leave unset: the browser then connects back to the origin it loaded from,
# which is what makes tunnels and single port hosting work.
# NEXT_PUBLIC_SOCKET_URL=
